    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "oxfmt": "0.61.0",
